# Installs resolve public packages from npm. The package names are unscoped, so publishing
# denebola / create-denebola to the private registry uses an explicit --registry
# (scripts/release.mjs and the release workflow). Auth comes from the environment
# (NODE_AUTH_TOKEN) or a user-level .npmrc, so no secret lives in the repository.
registry=https://registry.npmjs.org/
@jsr:registry=https://npm.jsr.io/
