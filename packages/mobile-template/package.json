{
  "name": "denebola",
  "version": "0.1.0",
  "description": "Production-oriented Expo + React Native foundation as an installable runtime package.",
  "license": "Apache-2.0",
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "react-native": "src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "react-native": "./src/index.tsx",
      "import": "./src/index.tsx",
      "require": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "migrations",
    "app.plugin.js",
    "nativewind-env.d.ts",
    "README.md"
  ],
  "bin": {
    "denebola-doctor": "bin/doctor.mjs",
    "denebola-migrate": "bin/migrate.mjs",
    "denebola-update": "bin/update.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/streamwhite/mobile-dev-template-expo.git",
    "directory": "packages/mobile-template"
  },
  "keywords": [
    "expo",
    "react-native",
    "expo-router",
    "nativewind",
    "template",
    "mobile"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --out-file i18n/extracted.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "prepublishOnly": "npm run typecheck"
  },
  "peerDependencies": {
    "react": "~19.2.0",
    "react-native": "~0.86.0"
  },
  "dependencies": {
    "@formatjs/intl-datetimeformat": "^7.7.1",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.11",
    "@formatjs/intl-numberformat": "^9.4.3",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@formatjs/intl-relativetimeformat": "^12.3.15",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@tanstack/react-query": "^5.103.1",
    "consola": "^3.4.2",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react-intl": "^7.1.14",
    "react-native-safe-area-context": "~5.10.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.16.30",
    "@types/react": "^19.3.0",
    "nativewind": "4.2.7",
    "react-native-css-interop": "0.2.7",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
