{
  "name": "mobile-dev-template-expo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:client": "expo start --dev-client",
    "dev:go": "expo start",
    "dev:web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "emulator:accelerate": "bash scripts/enable-android-emulator-acceleration.sh",
    "build:development": "eas build --profile development",
    "build:development:ios": "eas build --profile development --platform ios",
    "build:development:android": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "submit:production": "eas submit --profile production --latest",
    "update:rollback": "eas update:rollback --channel production --message",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:component": "jest --config jest.config.js",
    "typecheck": "tsc --noEmit",
    "format:check": "biome check .",
    "i18n:extract": "formatjs extract 'packages/mobile-template/src/**/*.{ts,tsx}' --out-file i18n/extracted.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "i18n:compile": "formatjs compile-folder packages/mobile-template/src/lib/i18n/messages compiled-messages",
    "i18n:validate": "vitest run tests/unit/translation-validation.test.ts tests/unit/i18n-messages.test.ts",
    "update:staging": "eas update --channel staging --message",
    "update:production": "eas update --channel production --message",
    "test:packages": "vitest run tests/unit",
    "pack:packages": "pnpm -r --filter \"./packages/**\" exec npm pack --dry-run",
    "publish:dry-run": "pnpm -r --filter \"./packages/**\" exec npm publish --dry-run",
    "verify:consumer": "bash scripts/verify-consumer-fixture.sh",
    "template:doctor": "node packages/mobile-template/bin/doctor.mjs",
    "template:update": "node packages/mobile-template/bin/update.mjs",
    "template:migrate": "node packages/mobile-template/bin/migrate.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@formatjs/intl-datetimeformat": "^7.7.1",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.11",
    "@formatjs/intl-numberformat": "^9.4.3",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@formatjs/intl-relativetimeformat": "^12.3.15",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.1",
    "@your-scope/mobile-template": "workspace:*",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "nativewind": "4.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.88.0",
    "react-intl": "^7.1.14",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.12.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@formatjs/cli": "^6.16.30",
    "@playwright/test": "^1.63.0",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.17.1",
    "babel-preset-expo": "~57.0.12",
    "eas-cli": "^24.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
